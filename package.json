{
  "name": "aetos-office-assistant",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "mac:setup": "node scripts/build.mjs && node scripts/mac-cert.mjs && node scripts/mac-sideload.mjs",
    "mac:cert": "node scripts/mac-cert.mjs",
    "mac:sideload": "node scripts/mac-sideload.mjs",
    "mac:doctor": "node scripts/mac-doctor.mjs",
    "mac:terminal": "open -a Terminal scripts/mac-start.command"
  }
}
