{
  "name": "aetos-office-assistant",
  "version": "0.2.11",
  "private": true,
  "license": "Apache-2.0",
  "author": "YOUBIQUO S.r.l. (https://www.youbiquo.eu)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "sync": "bash scripts/sync-gitlab.sh",
    "sync:install": "bash scripts/install-sync-agent.sh",
    "sync:status": "bash scripts/install-sync-agent.sh --status",
    "sync:remove": "bash scripts/install-sync-agent.sh --uninstall",
    "start": "node scripts/serve.mjs",
    "mac:setup": "node scripts/build.mjs && node scripts/mac-cert.mjs && node scripts/mac-sideload.mjs",
    "mac:cert": "node scripts/mac-cert.mjs",
    "mac:sideload": "node scripts/mac-sideload.mjs",
    "mac:doctor": "node scripts/mac-doctor.mjs",
    "mac:terminal": "open -a Terminal scripts/mac-start.command"
  }
}
